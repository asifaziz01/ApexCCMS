NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787
DATABASE_URL=postgresql://ccms_app:change-me-local-only@localhost:5432/northern_star_ccms
OIDC_ISSUER_URL=https://identity.example.ca
OIDC_JWKS_URL=https://identity.example.ca/.well-known/jwks.json
OIDC_CLIENT_ID=northern-star-ccms
OIDC_CLIENT_SECRET=replace-me
